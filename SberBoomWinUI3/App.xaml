<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SberBoom.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBg" Color="#07090C" />
                    <SolidColorBrush x:Key="AppSurface" Color="#0F1319" />
                    <SolidColorBrush x:Key="AppSurface2" Color="#11151B" />
                    <SolidColorBrush x:Key="AppChip" Color="#171C23" />
                    <SolidColorBrush x:Key="AppText" Color="#EDF1F4" />
                    <SolidColorBrush x:Key="AppTextMuted" Color="#A9B3BF" />
                    <SolidColorBrush x:Key="AppAccent" Color="#3BE089" />
                    <SolidColorBrush x:Key="AppOnAccent" Color="#00301A" />
                    <SolidColorBrush x:Key="AppAccentSoft" Color="#0E4A2B" />
                    <SolidColorBrush x:Key="AppError" Color="#FF8A8A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBg" Color="#F4F2F7" />
                    <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSurface2" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppChip" Color="#E5E1EC" />
                    <SolidColorBrush x:Key="AppText" Color="#111820" />
                    <SolidColorBrush x:Key="AppTextMuted" Color="#4B5560" />
                    <SolidColorBrush x:Key="AppAccent" Color="#0B8A4D" />
                    <SolidColorBrush x:Key="AppOnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppAccentSoft" Color="#CDEFDD" />
                    <SolidColorBrush x:Key="AppError" Color="#BA1A1A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppChip}" />
                <Setter Property="Foreground" Value="{ThemeResource AppTextMuted}" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppAccent}" />
                <Setter Property="Foreground" Value="{ThemeResource AppOnAccent}" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
