<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SberBoom.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Собственный заголовок: Fluent-контент продолжается в title bar -->
        <Grid x:Name="TitleBarRow" Grid.Row="0" Height="40" Padding="16,0,0,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F5;" FontSize="14"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="TitleText" Text="SberBoom Remote" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="1" x:Name="TitleBarDragArea" Background="Transparent" />
        </Grid>

        <!-- ═══════════ подключение ═══════════ -->
        <ScrollViewer x:Name="ConnectView" Grid.Row="1" Padding="24,4,24,24"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" MaxWidth="420" HorizontalAlignment="Stretch">
                <FontIcon Glyph="&#xE7F5;" FontSize="40" HorizontalAlignment="Left"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="SberBoom" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Локальное управление колонкой по Wi-Fi. Без облака, аккаунта и токенов Сбера." />

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <ProgressRing x:Name="ScanRing" Width="16" Height="16" IsActive="False" />
                    <TextBlock x:Name="ScanStatus" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Text="Готово к поиску" />
                </StackPanel>

                <ListView x:Name="SpeakersList" SelectionMode="Single" MaxHeight="160"
                          IsItemClickEnabled="True" ItemClick="SpeakersList_ItemClick" CornerRadius="8" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ScanButton" Content="Найти колонки" Click="ScanButton_Click" />
                    <Button x:Name="PairButton" Content="Сопряжение" Click="PairButton_Click" />
                </StackPanel>

                <TextBlock Text="Или введите адрес вручную" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,8,0,0" />
                <TextBox x:Name="HostBox" PlaceholderText="192.168.0.178" CornerRadius="4" />
                <Button x:Name="ConnectButton" Content="Подключиться"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Click="ConnectButton_Click" />

                <InfoBar x:Name="ConnectErrorBar" IsOpen="False" Severity="Error"
                         Title="Не удалось подключиться" IsClosable="True" />

                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="При первом подключении колонка попросит подтвердить доступ кнопкой «+» на корпусе." />

                <Button x:Name="ForgetButton" Content="Забыть сохранённую колонку"
                        Visibility="Collapsed" Click="ForgetButton_Click" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════ плеер ═══════════ -->
        <ScrollViewer x:Name="PlayerView" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <Grid Padding="24,0,24,24" RowSpacing="14" MaxWidth="440">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE7F5;" FontSize="20" VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="SpeakerName" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="На связи" />
                            <TextBlock x:Name="HostText" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="DeviceLine" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- меню: три точки -->
                    <Button Grid.Column="2" Style="{StaticResource TransportButton}"
                            VerticalAlignment="Center" ToolTipService.ToolTip="Меню">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Поиск в Звуке" Click="OpenSearch_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Очередь" Click="OpenQueue_Click" />
                                <MenuFlyoutItem Text="Текст песни" Click="OpenLyrics_Click" />
                                <MenuFlyoutItem Text="Bluetooth" Click="OpenBluetooth_Click" />
                                <MenuFlyoutItem Text="Недавнее" Click="OpenHistory_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Состояние колонки" Click="DevicePanel_Click" />
                                <MenuFlyoutItem Text="Диагностика связи" Click="OpenDiagnostics_Click" />
                                <MenuFlyoutItem Text="Таймер сна" Click="OpenSleepTimer_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Обновить" Click="Refresh_Click" />
                                <MenuFlyoutItem Text="Сопряжение заново" Click="PairAgain_Click" />
                                <MenuFlyoutItem Text="Играть с телефона" Click="OpenBluetoothPairing_Click" />
                                <MenuFlyoutItem Text="Сменить колонку" Click="ChangeSpeaker_Click" />
                                <MenuFlyoutItem x:Name="ThemeMenuItem" Text="Светлая тема" Click="Theme_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Забыть колонку" Click="ForgetButton_Click" />
                                <MenuFlyoutItem Text="Отключиться" Click="Disconnect_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- обложка -->
                <Border Grid.Row="1" CornerRadius="8" MinHeight="140" VerticalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="CoverImage" Stretch="UniformToFill" />
                        <FontIcon x:Name="CoverPlaceholder" Glyph="&#xE8D6;" FontSize="64" Opacity="0.4"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border x:Name="SourceBadge" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                Margin="12" Padding="10,5" CornerRadius="4"
                                Background="#E6000000" BorderBrush="#33FFFFFF" BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="SourceText" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="#FFFFFFFF" FontWeight="SemiBold" />
                        </Border>
                        <ProgressRing x:Name="BufferRing" Width="18" Height="18" IsActive="False"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                      Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- трек -->
                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock x:Name="TrackTitle" Text="Ничего не играет"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrackArtist" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrackAlbum" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.85"
                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrackLyricLine" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               MaxLines="1" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                               Margin="0,4,0,0" Tapped="OpenLyrics_Click" />
                </StackPanel>

                <!-- прогресс -->
                <StackPanel Grid.Row="3">
                    <Slider x:Name="ProgressSlider" Minimum="0" Maximum="100" StepFrequency="1"
                            ValueChanged="ProgressSlider_ValueChanged" />
                    <Grid>
                        <TextBlock x:Name="PositionText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Left" Text="0:00" />
                        <TextBlock x:Name="DurationText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" Text="0:00" />
                    </Grid>
                </StackPanel>

                <!-- транспорт -->
                <Grid Grid.Row="4" HorizontalAlignment="Center" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ShuffleButton" Grid.Column="0" Style="{StaticResource TransportButton}"
                            Click="Shuffle_Click" ToolTipService.ToolTip="Перемешать">
                        <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontSize="18" />
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource TransportButton}" Click="Prev_Click"
                            ToolTipService.ToolTip="Предыдущий">
                        <FontIcon Glyph="&#xE892;" FontSize="24" />
                    </Button>
                    <Button x:Name="PlayButton" Grid.Column="2" Width="56" Height="56"
                            Style="{StaticResource AccentButtonStyle}" CornerRadius="28"
                            Click="Play_Click" ToolTipService.ToolTip="Играть / пауза">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="22" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource TransportButton}" Click="Next_Click"
                            ToolTipService.ToolTip="Следующий">
                        <FontIcon Glyph="&#xE893;" FontSize="24" />
                    </Button>
                    <Button x:Name="RepeatButton" Grid.Column="4" Style="{StaticResource TransportButton}"
                            Click="Repeat_Click" ToolTipService.ToolTip="Повтор">
                        <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="18" />
                    </Button>
                </Grid>

                <!-- вторичные действия -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                    <Button x:Name="LikeButton" Style="{StaticResource TransportButton}"
                            Click="Like_Click" ToolTipService.ToolTip="Нравится">
                        <FontIcon x:Name="LikeIcon" Glyph="&#xE8E1;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="Dislike_Click"
                            ToolTipService.ToolTip="Не нравится">
                        <FontIcon Glyph="&#xE8E0;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="Speed_Click"
                            ToolTipService.ToolTip="Скорость">
                        <TextBlock x:Name="SpeedText" Style="{StaticResource CaptionTextBlockStyle}" Text="1×" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="OpenLyrics_Click"
                            ToolTipService.ToolTip="Текст песни">
                        <FontIcon Glyph="&#xE7C3;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="OpenQueue_Click"
                            ToolTipService.ToolTip="Очередь — что дальше">
                        <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="OpenBluetooth_Click"
                            ToolTipService.ToolTip="Bluetooth">
                        <FontIcon Glyph="&#xE702;" FontSize="16" />
                    </Button>
                </StackPanel>

                <!-- громкость -->
                <Grid Grid.Row="6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MuteButton" Grid.Column="0" Style="{StaticResource TransportButton}"
                            Click="Mute_Click" ToolTipService.ToolTip="Звук">
                        <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="16" />
                    </Button>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                            StepFrequency="1" VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged" />
                    <TextBlock x:Name="VolumeText" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Width="36" VerticalAlignment="Center" Text="0%" />
                </Grid>

                <TextBlock x:Name="SleepTimerText" Grid.Row="7" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>

        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" Severity="Informational"
                 IsClosable="True" VerticalAlignment="Bottom" Margin="12" />
    </Grid>
</Window>
