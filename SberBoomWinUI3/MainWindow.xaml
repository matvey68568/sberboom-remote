<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SberBoom.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Фон окна — Mica (задаётся кодом); корневая сетка прозрачная. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ подключение ═══════════ -->
        <ScrollViewer x:Name="ConnectView" Grid.Row="1" Padding="24,8,24,24"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" MaxWidth="420" HorizontalAlignment="Stretch">

                <FontIcon Glyph="&#xE7F5;" FontSize="40" HorizontalAlignment="Left"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <TextBlock Text="SberBoom" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Локальное управление колонкой по Wi-Fi. Без облака, аккаунта и токенов Сбера." />

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <ProgressRing x:Name="ScanRing" Width="16" Height="16" IsActive="False" />
                    <TextBlock x:Name="ScanStatus" Style="{StaticResource MetaText}"
                               VerticalAlignment="Center" Text="Готово к поиску" />
                </StackPanel>

                <ListView x:Name="SpeakersList" SelectionMode="Single" MaxHeight="160"
                          IsItemClickEnabled="True" ItemClick="SpeakersList_ItemClick"
                          CornerRadius="8" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ScanButton" Content="Найти колонки" Click="ScanButton_Click" />
                    <Button x:Name="PairButton" Content="Сопряжение" Click="PairButton_Click" />
                </StackPanel>

                <TextBlock Text="Или введите адрес вручную" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,8,0,0" />

                <TextBox x:Name="HostBox" PlaceholderText="192.168.0.178" CornerRadius="4" />
                <Button x:Name="ConnectButton" Content="Подключиться"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Click="ConnectButton_Click" />

                <InfoBar x:Name="ConnectErrorBar" IsOpen="False" Severity="Error"
                         Title="Не удалось подключиться" IsClosable="True" />

                <TextBlock Style="{StaticResource MetaText}" TextWrapping="Wrap"
                           Text="При первом подключении колонка попросит подтвердить доступ кнопкой «+» на корпусе." />

                <Button x:Name="ForgetButton" Content="Забыть сохранённую колонку"
                        Visibility="Collapsed" Click="ForgetButton_Click" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════ плеер ═══════════ -->
        <ScrollViewer x:Name="PlayerView" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,4,24,24" Spacing="16" MaxWidth="440">

                <!-- шапка: колонка + статус + меню -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE7F5;" FontSize="22"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="SpeakerName" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" Text="На связи" />
                            <TextBlock x:Name="HostText" Style="{StaticResource MetaText}" />
                        </StackPanel>
                        <TextBlock x:Name="DeviceLine" Style="{StaticResource MetaText}"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource TransportButton}"
                            VerticalAlignment="Center" Click="ChangeSpeaker_Click"
                            ToolTipService.ToolTip="Сменить колонку">
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource TransportButton}" Margin="0,0,36,0"
                            VerticalAlignment="Center" ToolTipService.ToolTip="Ещё">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Состояние колонки" Click="DevicePanel_Click" />
                                <MenuFlyoutItem Text="Обновить" Click="Refresh_Click" />
                                <MenuFlyoutItem Text="Сопряжение заново" Click="PairAgain_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Найти пульт" Click="FindRemote_Click" />
                                <MenuFlyoutItem x:Name="ThemeMenuItem" Text="Светлая тема" Click="Theme_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Забыть колонку" Click="ForgetButton_Click" />
                                <MenuFlyoutItem Text="Отключиться" Click="Disconnect_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- обложка: карточка Fluent -->
                <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="CoverImage" Stretch="UniformToFill" Height="300" />
                        <FontIcon x:Name="CoverPlaceholder" Glyph="&#xE8D6;" FontSize="64"
                                  Opacity="0.4"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border x:Name="SourceBadge" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                Margin="12" Padding="8,3" CornerRadius="4"
                                Background="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                                Visibility="Collapsed">
                            <TextBlock x:Name="SourceText" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="White" />
                        </Border>
                        <ProgressRing x:Name="BufferRing" Width="18" Height="18" IsActive="False"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                      Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- трек -->
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TrackTitle" Text="Ничего не играет"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrackArtist" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrackAlbum" Style="{StaticResource MetaText}"
                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- прогресс: штатный Fluent Slider -->
                <StackPanel Spacing="0">
                    <Slider x:Name="ProgressSlider" Minimum="0" Maximum="100" StepFrequency="1"
                            ValueChanged="ProgressSlider_ValueChanged"
                            ThumbToolTipValueConverter="{x:Null}" />
                    <Grid>
                        <TextBlock x:Name="PositionText" Style="{StaticResource MetaText}"
                                   HorizontalAlignment="Left" Text="0:00" />
                        <TextBlock x:Name="DurationText" Style="{StaticResource MetaText}"
                                   HorizontalAlignment="Right" Text="0:00" />
                    </Grid>
                </StackPanel>

                <!-- транспорт -->
                <Grid HorizontalAlignment="Center" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ShuffleButton" Grid.Column="0" Style="{StaticResource TransportButton}"
                            Click="Shuffle_Click" ToolTipService.ToolTip="Перемешать">
                        <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontSize="18" />
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource TransportButton}" Click="Prev_Click"
                            ToolTipService.ToolTip="Предыдущий">
                        <FontIcon Glyph="&#xE892;" FontSize="24" />
                    </Button>

                    <Button x:Name="PlayButton" Grid.Column="2" Width="56" Height="56"
                            Style="{StaticResource AccentButtonStyle}" CornerRadius="28"
                            Click="Play_Click" ToolTipService.ToolTip="Играть / пауза">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="22" />
                    </Button>

                    <Button Grid.Column="3" Style="{StaticResource TransportButton}" Click="Next_Click"
                            ToolTipService.ToolTip="Следующий">
                        <FontIcon Glyph="&#xE893;" FontSize="24" />
                    </Button>

                    <Button x:Name="RepeatButton" Grid.Column="4" Style="{StaticResource TransportButton}"
                            Click="Repeat_Click" ToolTipService.ToolTip="Повтор">
                        <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="18" />
                    </Button>
                </Grid>

                <!-- вторичные действия -->
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <Button x:Name="LikeButton" Style="{StaticResource TransportButton}"
                            Click="Like_Click" ToolTipService.ToolTip="Нравится">
                        <FontIcon x:Name="LikeIcon" Glyph="&#xE8E1;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="Speed_Click"
                            ToolTipService.ToolTip="Скорость">
                        <TextBlock x:Name="SpeedText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="1×" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="FindRemote_Click"
                            ToolTipService.ToolTip="Найти пульт">
                        <FontIcon Glyph="&#xE8B6;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="Refresh_Click"
                            ToolTipService.ToolTip="Обновить">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                </StackPanel>

                <!-- громкость -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MuteButton" Grid.Column="0" Style="{StaticResource TransportButton}"
                            Click="Mute_Click" ToolTipService.ToolTip="Звук">
                        <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="16" />
                    </Button>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                            StepFrequency="1" VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged"
                            ThumbToolTipValueConverter="{x:Null}" />
                    <TextBlock x:Name="VolumeText" Grid.Column="2" Style="{StaticResource MetaText}"
                               Width="36" VerticalAlignment="Center" Text="0%" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- оверлей сопряжения: стандартный ContentDialog-подобный слой -->
        <Grid x:Name="PairingOverlay" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{ThemeResource SmokeFillColorDefaultBrush}">
            <ContentDialog x:Name="PairingDialog" Title="Сопряжение"
                           PrimaryButtonText="Отменить" DefaultButton="Primary"
                           PrimaryButtonClick="CancelPairing_Click"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12" Width="320">
                    <FontIcon Glyph="&#xE7F5;" FontSize="32"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Нажмите «+» на колонке"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Один раз подтвердите доступ кнопкой громкости «+» на корпусе SberBoom. Токен сохранится, дальше подключение автоматическое." />
                    <ProgressBar IsIndeterminate="True" />
                </StackPanel>
            </ContentDialog>
        </Grid>

        <!-- уведомления -->
        <InfoBar x:Name="Notice" Grid.Row="0" IsOpen="False" Severity="Informational"
                 IsClosable="True" Margin="12,8,12,0" VerticalAlignment="Top" />
    </Grid>
</Window>
