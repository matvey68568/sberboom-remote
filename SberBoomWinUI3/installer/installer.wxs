<?xml version="1.0" encoding="utf-8"?>
<!--
  Установщик Windows-версии (WinUI 3). Собирается WiX Toolset 3.14:
    heat.exe dir ..\dist -cg AppFiles ...
    candle.exe installer.wxs Files.wxs
    light.exe  -ext WixUIExtension ...
  Список файлов приложения генерируется heat'ом и лежит отдельно (Files.wxs),
  поэтому при обновлении сборки его нужно перегенерировать.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="$(var.ProductCodeId)"
           Name="SberBoom Remote"
           Language="1049"
           Version="$(var.ProductVersion)"
           Manufacturer="SberBoom Remote"
           UpgradeCode="8F2F0F4E-6A4F-4A1E-9C6B-0D3A5B9C7F21">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Platform="x64" />
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />
    <MajorUpgrade DowngradeErrorMessage="Установлена более новая версия SberBoom Remote." />
    <MediaTemplate EmbedCab="yes" />

    <!-- иконка приложения: ярлыки и «Программы и компоненты» -->
    <Icon Id="AppIcon" SourceFile="../Assets/app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="SberBoom Remote" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="SberBoom Remote" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <!-- ярлык в меню «Пуск» -->
    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="A1B2C3D4-1111-4A4A-9A9A-111111111111">
      <Shortcut Id="StartMenuLink"
                Name="SberBoom Remote"
                Description="Локальное управление колонкой SberBoom"
                Target="[INSTALLFOLDER]SberBoomRemote.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" IconIndex="0" />
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\SberBoom Remote" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- ярлык на рабочем столе -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="A1B2C3D4-2222-4A4A-9A9A-222222222222">
      <Shortcut Id="DesktopLink"
                Name="SberBoom Remote"
                Description="Локальное управление колонкой SberBoom"
                Target="[INSTALLFOLDER]SberBoomRemote.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" IconIndex="0" />
      <RegistryValue Root="HKCU" Key="Software\SberBoom Remote" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="SberBoom Remote" Level="1" Display="expand">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Property Id="ARPHELPLINK" Value="https://github.com/matvey68568/sberboom-remote" />

    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
  </Product>
</Wix>
